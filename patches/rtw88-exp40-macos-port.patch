diff --git a/drivers/net/wireless/realtek/rtw88/main.c b/drivers/net/wireless/realtek/rtw88/main.c
index 493b71e..5bb0d46 100644
--- a/drivers/net/wireless/realtek/rtw88/main.c
+++ b/drivers/net/wireless/realtek/rtw88/main.c
@@ -236,6 +236,7 @@ static void rtw_watch_dog_work(struct work_struct *work)
 	bool busy_traffic = test_bit(RTW_FLAG_BUSY_TRAFFIC, rtwdev->flags);
 	int received_beacons = rtwdev->dm_info.cur_pkt_count.num_bcn_pkt;
 	u32 tx_unicast_mbps, rx_unicast_mbps;
+	bool macos_high_load;
 	bool ps_active;
 
 	mutex_lock(&rtwdev->mutex);
@@ -246,9 +247,13 @@ static void rtw_watch_dog_work(struct work_struct *work)
 	ieee80211_queue_delayed_work(rtwdev->hw, &rtwdev->watch_dog_work,
 				     RTW_WATCH_DOG_DELAY_TIME);
 
-	/* Diagnostic: skip all RF-dynamic work + coex queries. */
-	if (rtw88_disable_watchdog_work)
+	/* macOS: keep the potentially troublesome full RF-dynamic path disabled,
+	 * but retain the one piece firmware rate adaptation needs: fresh RSSI for
+	 * the associated STA.  This deliberately avoids DIG/DPK/power tracking. */
+	if (rtw88_disable_watchdog_work) {
+		rtwdev->watch_dog_cnt++;
 		goto unlock;
+	}
 
 	if (rtwdev->stats.tx_cnt > 100 || rtwdev->stats.rx_cnt > 100)
 		set_bit(RTW_FLAG_BUSY_TRAFFIC, rtwdev->flags);
@@ -266,6 +271,10 @@ static void rtw_watch_dog_work(struct work_struct *work)
 
 	tx_unicast_mbps = stats->tx_unicast >> RTW_TP_SHIFT;
 	rx_unicast_mbps = stats->rx_unicast >> RTW_TP_SHIFT;
+	/* Keep the complete watchdog alive, but do not run the expensive RF/coex
+	 * control transactions in the middle of a saturated data burst.  Those
+	 * transactions contend with the BE DMA doorbell on this macOS port. */
+	macos_high_load = busy_traffic || tx_unicast_mbps >= 1 || rx_unicast_mbps >= 1;
 
 	ewma_tp_add(&stats->tx_ewma_tp, tx_unicast_mbps);
 	ewma_tp_add(&stats->rx_ewma_tp, rx_unicast_mbps);
@@ -281,13 +290,17 @@ static void rtw_watch_dog_work(struct work_struct *work)
 	if (test_bit(RTW_FLAG_SCANNING, rtwdev->flags))
 		goto unlock;
 
-	/* make sure BB/RF is working for dynamic mech */
-	rtw_leave_lps(rtwdev);
-	rtw_coex_wl_status_check(rtwdev);
-	rtw_coex_query_bt_hid_list(rtwdev);
-	rtw_coex_active_query_bt_info(rtwdev);
-
-	rtw_phy_dynamic_mechanism(rtwdev);
+	/* RSSI/RA remains serviced on every tick.  Defer only the heavyweight
+	 * coexistence and RF tracking work while traffic is flowing. */
+	if (macos_high_load) {
+		rtw_phy_macos_rssi_feed(rtwdev);
+	} else {
+		rtw_leave_lps(rtwdev);
+		rtw_coex_wl_status_check(rtwdev);
+		rtw_coex_query_bt_hid_list(rtwdev);
+		rtw_coex_active_query_bt_info(rtwdev);
+		rtw_phy_dynamic_mechanism(rtwdev);
+	}
 
 	rtw_hci_dynamic_rx_agg(rtwdev,
 			       tx_unicast_mbps >= 1 || rx_unicast_mbps >= 1);
