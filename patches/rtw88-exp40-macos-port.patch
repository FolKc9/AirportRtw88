diff --git a/drivers/net/wireless/realtek/rtw88/pci.c b/drivers/net/wireless/realtek/rtw88/pci.c
index 89aef8c..cb09fc0 100644
--- a/drivers/net/wireless/realtek/rtw88/pci.c
+++ b/drivers/net/wireless/realtek/rtw88/pci.c
@@ -1137,8 +1137,15 @@ static u32 rtw_pci_rx_napi(struct rtw_dev *rtwdev, struct rtw_pci *rtwpci,
 		rtw_pci_dma_check(rtwdev, ring, cur_rp);
 		skb = ring->buf[cur_rp];
 		dma = *((dma_addr_t *)skb->cb);
+#ifdef RTW88_MACOS
+		/* macOS uses a software bounce buffer. Copy only the RX descriptor
+		 * first so pkt_len can be decoded; copying the full 11K buffer for
+		 * every descriptor was the dominant downlink CPU/memory cost. */
+		dma_sync_single_for_cpu(rtwdev->dev, dma, pkt_desc_sz, DMA_FROM_DEVICE);
+#else
 		dma_sync_single_for_cpu(rtwdev->dev, dma, RTK_PCI_RX_BUF_SIZE,
 					DMA_FROM_DEVICE);
+#endif
 		rx_desc = skb->data;
 		rtw_rx_query_rx_desc(rtwdev, rx_desc, &pkt_stat, &rx_status);
 
@@ -1150,6 +1157,16 @@ static u32 rtw_pci_rx_napi(struct rtw_dev *rtwdev, struct rtw_pci *rtwpci,
 		 * discard the frame if none available
 		 */
 		new_len = pkt_stat.pkt_len + pkt_offset;
+		if (unlikely(new_len > RTK_PCI_RX_BUF_SIZE))
+			goto next_rp;
+#ifdef RTW88_MACOS
+		/* Now that the descriptor told us the real frame length, copy only
+		 * bytes the driver will actually consume instead of all 11478 bytes.
+		 * The descriptor is copied twice, intentionally: it keeps the DMA shim
+		 * simple and the second copy is tiny relative to the old full-buffer
+		 * bounce copy. */
+		dma_sync_single_for_cpu(rtwdev->dev, dma, new_len, DMA_FROM_DEVICE);
+#endif
 		new = dev_alloc_skb(new_len);
 		if (WARN_ONCE(!new, "rx routine starvation\n"))
 			goto next_rp;
diff --git a/drivers/net/wireless/realtek/rtw88/phy.c b/drivers/net/wireless/realtek/rtw88/phy.c
index e2ac5c6..14718c6 100644
--- a/drivers/net/wireless/realtek/rtw88/phy.c
+++ b/drivers/net/wireless/realtek/rtw88/phy.c
@@ -322,6 +322,19 @@ static void rtw_phy_stat_rssi_iter(void *data, struct ieee80211_sta *sta)
 	u8 rssi;
 
 	rssi = ewma_rssi_read(&si->avg_rssi);
+#ifdef RTW88_MACOS
+	/* exp23: the corrected EWMA is deliberately preserved.  Calibrate only
+	 * the strong-signal RA input; exp12's broken EWMA accidentally provided
+	 * a similar positive bias, while weak links remain untouched. */
+	si->macos_ra_raw_rssi = rssi;
+	if (rssi >= 46)
+		si->macos_ra_calibrated_rssi = min_t(u8, rssi + 18, 100);
+	else if (rssi >= 38)
+		si->macos_ra_calibrated_rssi = min_t(u8, rssi + 8, 100);
+	else
+		si->macos_ra_calibrated_rssi = rssi;
+	rssi = si->macos_ra_calibrated_rssi;
+#endif
 	si->rssi_level = rtw_phy_get_rssi_level(si->rssi_level, rssi);
 
 	rtw_fw_send_rssi_info(rtwdev, si);
@@ -342,6 +355,14 @@ static void rtw_phy_stat_rssi(struct rtw_dev *rtwdev)
 	dm_info->min_rssi = data.min_rssi;
 }
 
+/* Feixiao/macOS minimal watchdog path: feed the firmware's rate-adaptation
+ * logic with per-station RSSI while leaving the rest of the dynamic PHY
+ * mechanism disabled. */
+void rtw_phy_macos_rssi_feed(struct rtw_dev *rtwdev)
+{
+	rtw_phy_stat_rssi(rtwdev);
+}
